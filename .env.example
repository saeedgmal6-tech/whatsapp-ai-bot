# OpenAI API key. API usage is billed by OpenAI.
OPENAI_API_KEY=

# Current OpenAI model. Change if your account exposes another model.
OPENAI_MODEL=gpt-5.6-luna

# Your WhatsApp number with country code, digits only. Egypt example: 2010XXXXXXXX
WHATSAPP_NUMBER=

# true = automatic replies, false = connected but no replies
BOT_ENABLED=true

# false = ignore groups; true = reply in groups too
REPLY_GROUPS=false

# Optional. Empty = reply to every private chat. Otherwise comma-separated numbers.
ALLOWED_NUMBERS=

# Optional custom personality/system instructions.
SYSTEM_PROMPT=

# Where WhatsApp login/session data is stored.
AUTH_DIR=./auth_info
