# OpenAI API key. Keep this secret and never commit .env.
OPENAI_API_KEY=

# OpenAI API model.
OPENAI_MODEL=gpt-5.6-luna

# Your WhatsApp number with country code, digits only.
WHATSAPP_NUMBER=

# true = automatic replies.
BOT_ENABLED=true

# false = ignore groups; true = reply in groups too.
REPLY_GROUPS=false

# Empty = reply to every private chat. Otherwise comma-separated numbers.
ALLOWED_NUMBERS=

# Optional. Leave empty to use the built-in Egyptian WhatsApp personality.
SYSTEM_PROMPT=

# WhatsApp login/session data.
AUTH_DIR=./auth_info
